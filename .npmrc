# typescript-eslint 8.57.2 has not published a TypeScript 6 peer range yet.
# Allow npm to install the current lint stack with the latest non-vulnerable
# TypeScript until upstream widens its peer dependency.
legacy-peer-deps=true

# Keep dependency install scripts restricted to reviewed packages. Including
# the VSCE signer here also keeps `npm exec` packaging self-contained.
allow-scripts=cpu-features@0.0.10,fsevents@2.3.3,ssh2@1.17.0,esbuild@0.28.2,@vscode/vsce-sign
