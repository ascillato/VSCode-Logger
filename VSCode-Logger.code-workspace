{
  "folders": [
    {
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "streetsidesoftware.code-spell-checker"
    ]
  },
  "settings": {
    "VsCodeTaskButtons.showCounter": false,
    "VsCodeTaskButtons.tasks": [
      {
        "label": "$(symbol-text)",
        "task": "Linter",
        "tooltip": "Linter Checks"
      },
      {
        "label": "$(check)",
        "task": "Compile_Ext",
        "tooltip": "Compile and Package Extension"
      },
      {
        "label": "$(check-all)",
        "task": "Install_Ext",
        "tooltip": "Install Extension"
      },
      {
        "label": "$(trash)",
        "task": "Clean_Compile",
        "tooltip": "Clean Compiled Files"
      },
      {
        "label": "More Tools",
        "tasks": [
          {
            "label": "$(test-view-icon) Run Tests",
            "task": "Test_Extension",
            "description": ""
          },
          {
            "label": "$(book) Generate Docs",
            "task": "Gen_Docs",
            "description": ""
          },
          {
            "label": "$(trash) Clean Built Docs",
            "task": "Clean_Docs",
            "description": ""
          },
          {
            "label": "$(check) Apply Linter Fixes when possible",
            "task": "Linter_fix",
            "description": ""
          }
        ]
      },
      {
        "label": "$(terminal)",
        "task": "NewTerminal",
        "tooltip": "New Terminal"
      }
    ],
    "makefile.configureOnOpen": false
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Linter",
        "type": "shell",
        "command": "make check",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Compile_Ext",
        "type": "shell",
        "command": "make package",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Install_Ext",
        "type": "shell",
        "command": "make all",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Clean_Compile",
        "type": "shell",
        "command": "make package-clean",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Gen_Docs",
        "type": "shell",
        "command": "make docs",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Clean_Docs",
        "type": "shell",
        "command": "make docs-clean",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Linter_fix",
        "type": "shell",
        "command": "make linter-fix",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "Test_Extension",
        "type": "shell",
        "command": "make test",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      },
      {
        "label": "NewTerminal",
        "type": "shell",
        "command": "${command:workbench.action.terminal.newInActiveWorkspace}",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "detail": "This task opens a new bash terminal."
      }
    ]
  }
}
